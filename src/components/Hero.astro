---
import ChartPanel from './ChartPanel.astro';
import { company } from '../lib/site';
---

<section id="chart">
  <div class="split">
    <div class="split-copy hero-copy">
      <h1 class="display display-hero">When to buy. When to sell.</h1>
      <p class="lede">
        The chart marks the turn in a stock. The screen lists the names sitting in the green.
      </p>
      <div class="actions">
        <a class="btn" href="#access">Request access</a>
      </div>
      <p class="call">
        Or call <a href={`tel:${company.phoneHref}`}>{company.phone}</a>. {company.hours}.
      </p>
    </div>
    <div class="hero-proof">
      <ChartPanel />
    </div>
  </div>
</section>
