---
import { faqs } from '../lib/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="band">
  <div class="split">
    <div class="split-copy">
      <h2 class="display display-sec">Before you write.</h2>
      <p class="prose">Five answers. If one of them rules us out, that is a fair result.</p>
    </div>
    <div>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline></script>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>
                {f.q}
                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M8 2v12M2 8h12"></path>
                </svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
