---
import { faqs } from '../lib/site';

// FAQPage schema so the honest answers are machine-readable too.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="scroll-mt-20 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.65fr)_minmax(0,1fr)] lg:gap-20">
      <div>
        <h2 class="display text-4xl text-white lg:text-5xl">
          The questions a<br class="hidden lg:block" /> skeptic asks first
        </h2>
        <p class="mt-5 text-sm leading-relaxed text-slate-400">
          If any answer here disqualifies us for you, that is a good outcome for both
          of us.
        </p>
      </div>

      <div class="divide-y divide-white/8 border-y border-white/8">
        {
          faqs.map((f, i) => (
            <details class="group" open={i === 0}>
              <summary
                class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[0.95rem] font-semibold text-white transition-colors hover:text-omega-300"
              >
                {f.q}
                <svg
                  viewBox="0 0 24 24"
                  class="mt-0.5 h-4 w-4 shrink-0 text-slate-500 transition-transform duration-200 group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="pr-10 pb-6 text-sm leading-relaxed text-slate-400">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</section>
