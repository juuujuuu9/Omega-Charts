---
import Logo from './Logo.astro';
import { nav } from '../lib/site';
---

<header class="fixed inset-x-0 top-3 z-40 flex justify-center px-3">
  <div
    class="flex items-center gap-1 rounded-full border border-white/12 bg-ink-950/80 py-1 pr-1 pl-2.5 shadow-[0_8px_24px_-12px_rgb(0_0_0/0.55)] backdrop-blur-md"
  >
    <a href="/" class="shrink-0 px-1.5 max-sm:[&_.wordmark]:hidden" aria-label="Omega Charts home">
      <Logo compact />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Main">
      {
        nav.map((l) => (
          <a
            href={l.href}
            class="whitespace-nowrap px-2.5 py-2 text-[0.8rem] font-medium text-slate-300 transition-[color] duration-150 hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="cursor-pointer list-none whitespace-nowrap rounded-full px-3 py-2 text-[0.8rem] font-medium text-slate-200"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 top-[calc(100%+0.5rem)] flex min-w-44 flex-col rounded-xl border border-white/12 bg-ink-950 p-2"
        aria-label="Main"
      >
        {
          nav.map((l) => (
            <a
              href={l.href}
              class="whitespace-nowrap rounded-lg px-3 py-2 text-sm text-slate-200 hover:bg-white/5"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>

    <a
      href="#guide"
      class="whitespace-nowrap rounded-full bg-omega-500 px-3.5 py-2 text-[0.8rem] font-semibold text-white transition-[background-color] duration-150 hover:bg-omega-400"
    >
      Get the guide
    </a>
  </div>
</header>
