---
/** Two sweeping arrows: green over the top, azure beneath. */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg
    viewBox="0 0 48 48"
    class:list={['shrink-0', compact ? 'h-7 w-7' : 'h-9 w-9']}
    role="img"
    aria-label="Omega Charts"
    fill="none"
  >
    <path
      d="M9.9 18.87 A15 15 0 0 1 36.99 16.5"
      stroke="var(--color-omega-500)"
      stroke-width="6.5"
      stroke-linecap="butt"
    />
    <path d="M39.99 21.7 L41.32 14.0 L32.66 19.0 Z" fill="var(--color-omega-500)" />

    <path
      d="M38.1 29.13 A15 15 0 0 1 11.01 31.5"
      stroke="var(--color-azure-500)"
      stroke-width="6.5"
      stroke-linecap="butt"
    />
    <path d="M8.01 26.3 L6.68 34.0 L15.34 29.0 Z" fill="var(--color-azure-500)" />
  </svg>

  <span class="flex flex-col leading-none">
    <span class="wordmark display text-[1.05rem] tracking-[0.06em] text-white">Omega Charts</span>
    {
      !compact && (
        <span class="mt-0.5 font-mono text-[0.5rem] tracking-[0.14em] text-azure-400 uppercase">
          Tomorrow&rsquo;s Technology Today
        </span>
      )
    }
  </span>
</span>
