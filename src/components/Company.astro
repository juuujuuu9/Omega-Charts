---
import { company } from '../lib/site';

const addr = company.address;
const mapsQuery = encodeURIComponent(
  `${addr.street}, ${addr.city}, ${addr.state} ${addr.zip}`,
);
---

<section id="company">
  <div class="split">
    <div class="split-copy">
      <h2 class="display display-sec">A firm you can call.</h2>
      <p class="prose">
        {company.legalName} is a Florida limited liability company in Fort Lauderdale. We sell
        access to the chart and the screen. We do not advise, we do not manage money, and we do
        not hold client funds.
      </p>
    </div>
    <dl class="facts">
      <div>
        <dt>Office</dt>
        <dd>
          {addr.street}<br />
          {addr.city}, {addr.state} {addr.zip}
        </dd>
        <dd>
          <a href={`https://maps.google.com/?q=${mapsQuery}`} target="_blank" rel="noopener noreferrer">
            Map
          </a>
        </dd>
      </div>
      <div>
        <dt>Telephone</dt>
        <dd>
          <a href={`tel:${company.phoneHref}`}>{company.phone}</a>
        </dd>
        <dd>{company.hours}. A person answers.</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </dd>
      </div>
    </dl>
  </div>
</section>
