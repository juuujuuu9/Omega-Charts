---
import { company, footerLinks, riskDisclosure } from '../lib/site';

const year = new Date().getFullYear();
const addr = company.address;
---

<footer class="foot">
  <p id="risk">{riskDisclosure}</p>
  <p class="colophon">
    {company.legalName}. {addr.street}, {addr.city}, {addr.state} {addr.zip}.{' '}
    <a href={`tel:${company.phoneHref}`}>{company.phone}</a>.{' '}
    <a href={`mailto:${company.email}`}>{company.email}</a>. {company.tagline}.{' '}
    {
      footerLinks.map((l, i) => (
        <>
          {i > 0 ? ' · ' : ''}
          <a href={l.href}>{l.label}</a>
        </>
      ))
    }
    . © {year}.
  </p>
</footer>
