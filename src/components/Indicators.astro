<section id="screen" class="band">
  <div class="split split-flip">
    <div class="split-copy">
      <h2 class="display display-sec">Names in the green.</h2>
      <p class="prose">
        The screen gathers the issues placed in the green, the names the work considers set to
        rise. The readings are mathematical. The method is not published.
      </p>
      <div class="actions">
        <a class="btn" href="#access">Request access</a>
      </div>
    </div>
    <figure class="roll-figure">
      <ol class="roll" aria-label="Drawing of the screened list. Names are not shown.">
        <li class="roll-head">
          <span>Issue</span>
          <span>Standing</span>
        </li>
        {
          [1, 2, 3, 4, 5].map(() => (
            <li>
              <span class="roll-rule" aria-hidden="true"></span>
              <span class="standing">Green</span>
            </li>
          ))
        }
      </ol>
      <figcaption>
        A drawing of the list. The live names are shown after access. Not a recommendation.
      </figcaption>
    </figure>
  </div>
</section>
