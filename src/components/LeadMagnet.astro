---
import { access, company } from '../lib/site';
---

<section id="access">
  <div class="split">
    <div class="split-copy">
      <h2 class="display display-sec">{access.title}</h2>
      <p class="prose">
        Leave your name and a telephone number. We call on a weekday. If the desk fits how you
        trade, we open it.
      </p>
      <p class="call">
        Prefer to speak now? <a href={`tel:${company.phoneHref}`}>{company.phone}</a>
      </p>
    </div>

    <div>
      <form id="lead-form" class="form" novalidate>
        <div class="field">
          <label for="firstName"><span>First name</span></label>
          <input id="firstName" name="firstName" type="text" autocomplete="given-name" required />
        </div>
        <div class="field">
          <label for="phone"><span>Telephone</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="email"><span>Email</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="hp" aria-hidden="true">
          <label for="company_website">Website</label>
          <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            Contact me about access. I understand Omega Charts is a software and education company,
            not an investment adviser.
          </span>
        </label>

        <p id="lead-error" class="form-note" role="alert"></p>

        <button type="submit" id="lead-submit" class="btn">
          <span data-label>Request access</span>
          <span data-spinner hidden>Sending</span>
        </button>
      </form>

      <div id="lead-success" class="success" hidden role="status">
        <h2 class="display">We will call.</h2>
        <p>{access.confirm}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const success = document.getElementById('lead-success');
  const errorBox = document.getElementById('lead-error');
  const submit = document.getElementById('lead-submit') as HTMLButtonElement | null;

  const digits = (value: string) => value.replace(/\D/g, '');

  if (form && success && errorBox && submit) {
    const label = submit.querySelector('[data-label]') as HTMLElement;
    const spinner = submit.querySelector('[data-spinner]') as HTMLElement;
    const fields = ['firstName', 'phone', 'email'] as const;

    const clearInvalid = () => {
      for (const name of fields) {
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.removeAttribute('aria-invalid');
      }
    };

    const showError = (msg: string, field?: string) => {
      errorBox.textContent = msg;
      clearInvalid();
      if (field) {
        form.querySelector<HTMLInputElement>(`[name="${field}"]`)?.setAttribute('aria-invalid', 'true');
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.textContent = '';
      clearInvalid();

      const data = new FormData(form);
      const firstName = String(data.get('firstName') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();

      if (!firstName) return showError('Please enter your first name.', 'firstName');
      if (digits(phone).length < 10) return showError('Please enter a telephone number.', 'phone');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email))
        return showError('Please enter a valid email address.', 'email');
      if (!data.get('consent')) return showError('Please tick the box so we may contact you.');

      submit.disabled = true;
      label.hidden = true;
      spinner.hidden = false;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(data.entries())),
        });
        const body = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) throw new Error(body.error || 'Something went wrong on our end.');

        form.hidden = true;
        success.hidden = false;
      } catch (err) {
        showError(
          err instanceof Error
            ? `${err.message} You can also call 954.890.4615.`
            : 'Network error. Please try again.',
        );
        submit.disabled = false;
        label.hidden = false;
        spinner.hidden = true;
      }
    });
  }
</script>
