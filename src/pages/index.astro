---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Indicators from '../components/Indicators.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Faq from '../components/Faq.astro';
import Company from '../components/Company.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Omega Charts — When to buy. When to sell."
  description="A private chart that marks when to buy and when to sell, and a screened list of names in the green. Request access. Omega Charts Global, Fort Lauderdale."
>
  <Header />
  <main id="main">
    <Hero />
    <Indicators />
    <LeadMagnet />
    <Faq />
    <Company />
  </main>
  <Footer />
</Base>
