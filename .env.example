# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. Must be on a domain you have verified in Resend.
# e.g. "Omega Charts <research@omegacharts.com>"
RESEND_FROM="Omega Charts <research@omegacharts.com>"

# Where new lead notifications are delivered (the client's inbox).
# Comma-separate for multiple recipients.
LEAD_NOTIFY_TO=info@omegacharts.com

# Optional: reply-to on the guide delivery email sent to the lead.
RESEND_REPLY_TO=info@omegacharts.com

# Public URL of the gated PDF the lead receives after opting in.
# Swap for a signed/expiring URL if you want stricter gating.
LEAD_MAGNET_URL=https://omegacharts.com/downloads/omega-charts-eight-percent-framework.pdf
